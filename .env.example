# ============================================
# 即影 - 环境变量配置
# 复制此文件为 .env.local 并填入你的密钥
# ============================================

# Supabase（后端数据库+Auth+存储）
# 获取地址：https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...

# 硅基流动 SiliconFlow（AI场景图+增强）
# 获取地址：https://cloud.siliconflow.cn → API密钥
SILICONFLOW_API_KEY=sk-xxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# rembg 抠图服务（自部署HTTP服务，免费）
# 本地部署：pip install rembg && rembg --host 0.0.0.0 --port 8000
# 生产环境：部署到阿里云/腾讯云GPU服务器
REMBG_API_URL=http://localhost:8000

# 应用配置
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=即影
